# 生产环境配置模板
# 注意：正式环境部署前必须修改 SECRET_KEY 和数据库密码
APP_ENV=prod

# 生产级数据库连接 (必须修改密码)
DATABASE_URL=postgresql://postgres:REPLACE_WITH_STRONG_PASSWORD@db:5432/hotrunner_mes_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=hotrunner_mes_prod

# 生产级强随机安全密钥 (必须修改)
SECRET_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET_KEY_MINIMUM_32_CHARS

# 生产级 CORS 域名限制 (按需修改为真实域名)
CORS_ORIGINS=https://mes.yourdomain.com,https://api.yourdomain.com

# 文件存储配置
UPLOAD_DIR=uploads
BACKUP_DIR=backups
PUBLIC_BASE_URL=https://api.yourdomain.com
